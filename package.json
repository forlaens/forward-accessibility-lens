{
  "name": "forward-accessibility-lens",
  "version": "1.0.9",
  "description": "A Chrome side-panel extension for practical accessibility inspection.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forlaens/forward-accessibility-lens.git"
  },
  "homepage": "https://forlaens.com/forward-udvidelser/",
  "bugs": {
    "url": "https://github.com/forlaens/forward-accessibility-lens/issues"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:extension && npm run test:a11y",
    "build:extension": "vite build && npx esbuild src/extension/content.js --bundle --format=iife --outfile=dist/content.js && npx esbuild src/extension/background.js --bundle --format=esm --outfile=dist/background.js && node scripts/clean-extension-package.js",
    "build:local": "npm run build:extension && node scripts/apply-local-extension-branding.js",
    "webstore:package": "npm run prepublish:check && node scripts/package-chrome-web-store.js",
    "webstore:status": "node scripts/chrome-web-store.js status",
    "webstore:upload": "node scripts/chrome-web-store.js upload",
    "webstore:publish": "node scripts/chrome-web-store.js publish",
    "webstore:release": "npm run webstore:package && node scripts/chrome-web-store.js release",
    "test": "vitest run",
    "test:a11y": "vitest run tests/accessibility.test.ts",
    "test:axe": "vitest run tests/axe.test.ts",
    "test:alfa": "vitest run tests/alfa.test.ts",
    "prepublish:check": "npm run build && npm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@siteimprove/alfa-rules": "^0.119.0",
    "@siteimprove/alfa-test": "^0.119.0",
    "@siteimprove/alfa-web": "^0.119.0",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "canvas": "^3.2.3",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
