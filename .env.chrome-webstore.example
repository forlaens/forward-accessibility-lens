# Copy this file to .env.chrome-webstore and fill in the private values.
# Do not commit .env.chrome-webstore.

# Extension ID from the Chrome Web Store item URL.
CHROME_WEBSTORE_EXTENSION_ID=eddnebfaphoibcpcnpiokjjcgnecfgpb

# Publisher ID from Chrome Web Store Developer Dashboard > Publisher > Settings.
CHROME_WEBSTORE_PUBLISHER_ID=

# Option A: Service account key file. This is the most CI/Fastlane-like setup.
# Create a Google Cloud service account, add its email to Chrome Web Store Developer Dashboard > Account > Service account,
# then create a JSON key and point this variable to it.
# CHROME_WEBSTORE_SERVICE_ACCOUNT_KEY_FILE=

# Option B: OAuth client credentials from Google Cloud Console.
CHROME_WEBSTORE_CLIENT_ID=
CHROME_WEBSTORE_CLIENT_SECRET=

# Refresh token created with the https://www.googleapis.com/auth/chromewebstore scope.
CHROME_WEBSTORE_REFRESH_TOKEN=

# Optional. Defaults to forward-accessibility-lens-{manifest version}-chrome-web-store.zip.
# CHROME_WEBSTORE_ZIP=

# Optional. DEFAULT_PUBLISH publishes after review; STAGED_PUBLISH stages after approval.
# CHROME_WEBSTORE_PUBLISH_TYPE=DEFAULT_PUBLISH

# Optional. Only succeeds when Chrome Web Store determines the update can skip review.
# CHROME_WEBSTORE_SKIP_REVIEW=false

# Optional. Initial rollout percentage, 0-100.
# CHROME_WEBSTORE_DEPLOY_PERCENTAGE=100
