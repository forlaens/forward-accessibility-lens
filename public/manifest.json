{
  "manifest_version": 3,
  "name": "Forward • Accessibility Lens",
  "description": "Inspect headings, landmarks, and other accessibility structures on the current page.",
  "version": "1.0.9",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "action": {
    "default_title": "Forward • Accessibility Lens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "index.html"
  }
}
